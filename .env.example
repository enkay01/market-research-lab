# Market Research Lab - Provider Credentials
# Copy this file to .env.local or set these variables in your local environment.

# Massive (Polygon) API Key (Used for downloading Stock Bars and Option Contracts/Trades)
# Free or paid tier key from https://massive.com or https://polygon.io
MASSIVE_API_KEY=your_massive_api_key_here
# POLYGON_API_KEY=your_polygon_api_key_here
# MASSIVE_STOCKS_PLAN_PROFILE=basic  # 'basic' (5 req/min, 1 worker) or 'paid' (95 req/s, 8 workers)
# MASSIVE_OPTIONS_PLAN_PROFILE=basic # 'basic' or 'paid'

# Alpaca API Credentials (Used for downloading Options minute bars/quotes)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_API_SECRET=your_alpaca_api_secret_here

# Tiingo API Token (Optional: Used for End-of-Day price history)
TIINGO_API_TOKEN=your_tiingo_api_token_here

# SEC EDGAR User Agent (Optional: Format: "Sample Company Name AdminContact@domain.com")
SEC_EDGAR_USER_AGENT=enkay01 11nkwochaian@gmail.com
