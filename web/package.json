{
  "name": "market-research-lab-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:client": "uv run --project ../engine python -m market_research_lab.export_openapi && openapi-typescript ../engine/openapi.json -o src/api/schema.ts",
    "check": "npm run generate:client && tsc --noEmit",
    "build": "npm run generate:client && tsc --noEmit && vite build"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.4.1",
    "@vitejs/plugin-react": "latest",
    "openapi-fetch": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "openapi-typescript": "latest",
    "playwright": "^1.62.1",
    "typescript": "latest"
  }
}
